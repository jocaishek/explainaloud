# Public Supabase identifiers, committed on purpose.
#
# Both of these are browser-safe by design: Next inlines every NEXT_PUBLIC_*
# value into the client bundle, so they are already served to anyone who loads
# the site. Keeping them here means a deploy cannot fail because a hosting
# dashboard is missing them. Row-level security, not secrecy, is what protects
# the data behind this key.
#
# Real secrets — GROQ_API_KEY, GEMINI_API_KEY, TAVILY_API_KEY — must NEVER be
# added to this file. They are server-only and belong in the host's encrypted
# environment settings.
#
# `.env.local` takes precedence over this file locally, so local development is
# unaffected.
NEXT_PUBLIC_SUPABASE_URL=https://pqimwgrecxvcqqogbbyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DHCurJ9OR5plARn-o6NDlQ_kvChkWru
