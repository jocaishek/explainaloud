# Names and instructions only — never real values. Copy what you need into
# `.env.local` (Next.js) or `.env` (Supabase CLI), both of which are gitignored.
#
# No hostname is committed anywhere in this repo. The domain is a property of a
# deployment, not of the code, so moving it is a change here plus a redeploy —
# never an edit to a source file.

# ---------------------------------------------------------------------------
# The app  →  set in Vercel (Production) and in `.env.local` for development
# ---------------------------------------------------------------------------

# Where this deployment answers, with protocol, no trailing slash.
# Drives Open Graph URLs, robots.txt and sitemap.xml via `src/lib/site.ts`.
# Unset, the code falls back to Vercel's own *.vercel.app host, then localhost.
#
# NEXT_PUBLIC_* is inlined at BUILD time, so changing this needs a redeploy —
# editing the value in the dashboard alone does nothing.
NEXT_PUBLIC_SITE_URL=

# The Google OAuth 2.0 Web client id, ending in .apps.googleusercontent.com.
#
# Its only job is to let Google Identity Services run the sign-in handshake on
# this origin. Without it the Google button falls back to Supabase's redirect,
# which works, but sends the browser to <project-ref>.supabase.co and so puts
# that host on Google's consent screen instead of this site's domain.
#
# Public by design. It is inlined into the browser bundle and the client secret
# is never used in this flow. What must also be set, outside this file:
#   Google Cloud Console -> Credentials -> this client -> Authorized JavaScript
#     origins: https://explainaloud.com and http://localhost:3000
#   Supabase -> Authentication -> Providers -> Google -> Authorized Client IDs:
#     this same value
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only AI providers. Never prefix these with NEXT_PUBLIC_: that would
# inline them into the browser bundle and publish them.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# The Vercel AI Gateway, used for one thing: the wide-context rung of the JSON
# failover chain, which sits between the two Groq tiers. Its 262K context window
# is the point — a prompt too large for Groq.s per-minute budget is too large for
# both Groq tiers, so without a wide-context rung in the middle an oversized
# request fails outright instead of degrading.
#
# Note that Gemini does NOT go through the Gateway: Google.s own endpoint serves
# gemini-3.5-flash-lite on a free-tier key, while the Gateway restricts that
# model to accounts with paid credits.
#
# Optional. Unset, that rung is skipped and the chain behaves as it did before.
AI_GATEWAY_API_KEY=

# --- Billing (Pro plan) ----------------------------------------------------
# All optional: unset, the app runs Free-only and the upgrade button reports
# that billing isn't set up rather than the site failing to boot.
#
# Prefer a RESTRICTED key (`rk_...`) over a secret key (`sk_...`). A restricted
# key carries only the permissions you grant it, so a leak does far less damage.
# This integration needs write on Checkout Sessions, Customers, Subscriptions
# and Billing Portal Sessions, and nothing else.
#
# Stripe → Developers → API keys → Create restricted key. Start in test mode.
#
# On Vercel, mark this as a SENSITIVE environment variable so the value is
# write-only and never shown in logs or the dashboard UI. Never commit it.
STRIPE_SECRET_KEY=
# The RECURRING PRICE id from the Pro product — starts `price_`, not `prod_`.
# A product id here fails at checkout with an unhelpful error.
STRIPE_PRICE_ID=
# From the webhook endpoint you create in Stripe (or `stripe listen` locally).
# Without it the webhook cannot distinguish a real Stripe event from a forged
# one, so it refuses every request — meaning nobody is ever upgraded.
STRIPE_WEBHOOK_SECRET=
# The key that bypasses row-level security. Used by exactly one file: the Stripe
# webhook, which has no user session and must write the `plan` column that users
# are forbidden from writing themselves. Treat it like a database password.
#
# Supabase → Project Settings → API Keys. This project is on the newer key
# format — its browser key is `sb_publishable_...` — so there is no key labelled
# `service_role` to find. The equivalent is a SECRET KEY (`sb_secret_...`):
# create one under "Secret keys". `service_role` is the legacy JWT name and only
# appears on projects still using the old format, under "Legacy API keys".
#
# Either format works here; supabase-js treats them the same.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The Supabase CLI  →  set in a root `.env`, read by `supabase/config.toml`
# ---------------------------------------------------------------------------
#
# `config.toml` reads these instead of pinning a literal, because
# `supabase config push` writes that file's values to the LINKED project — with
# a hardcoded localhost in there, one push would set production's Site URL to
# localhost and bounce every sign-in. Supabase falls back to Site URL whenever a
# requested redirect is not allow-listed.
#
# Point these at localhost while working locally, and at the real origin only in
# a shell that is deliberately pushing config to production.
#
#   SUPABASE_AUTH_SITE_URL=http://localhost:3000
#   SUPABASE_AUTH_REDIRECT_WILDCARD=http://localhost:3000/**
#
# The hosted project's Site URL and redirect allow-list are managed in the
# Supabase dashboard. These only matter to the local stack and to an explicit
# `config push`.
SUPABASE_AUTH_SITE_URL=
SUPABASE_AUTH_REDIRECT_WILDCARD=
